# ------------------------------------------------------------------
# .env.local.example
# このファイルをコピーして .env.local を作成し、値を入力してください。
#   cp .env.local.example .env.local
# .env.local は .gitignore で除外されており、コミットされません。
# 秘密情報は絶対にこのサンプルファイルへ直接書かないでください。
# ------------------------------------------------------------------

# === STEP 3（Google ログイン）に必要 ================================

# --- Supabase (公開情報。ブラウザに露出してよい) ---
# Supabase ダッシュボード → Project Settings → API から取得します。
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# アプリの公開 URL。OAuth のリダイレクト先の組み立てに使います。
# ローカル開発ではこの値のままで動きます。
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ※ Google のクライアント ID / シークレットは、このアプリではなく
#    Supabase ダッシュボード（Authentication → Providers → Google）に登録します。
#    アプリ側の環境変数には設定しません。

# === STEP 7 以降で必要（今は空のままで動きます） ====================

# --- Supabase (サーバー専用。絶対に NEXT_PUBLIC_ を付けない) ---
# RLS を迂回できる強力な鍵。自動更新バッチでのみ使用します。
SUPABASE_SERVICE_ROLE_KEY=

# --- Gmail 連携用の Google OAuth (サーバー専用) ---
# STEP 7 の「Gmail 連携」用。アプリへのログイン（STEP 3）とは別のクライアントです。
# ログイン用のクライアントを流用しないでください（必要な権限が異なります）。
# Google Cloud Console → API とサービス → 認証情報 →
#   OAuth クライアント ID を作成（種類: ウェブ アプリケーション）で取得します。
# 取得手順は README の「Gmail 連携の設定」を参照してください。
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=

# Google Cloud Console の「承認済みのリダイレクト URI」に登録した値と
# 完全に一致させてください（末尾のスラッシュや http/https の違いも不可）。
# ローカル開発: http://localhost:3000/api/integrations/gmail/callback
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:3000/api/integrations/gmail/callback

# --- 開発時の調査機能 (サーバー専用・任意) ---
# 請求メールの探索画面 (/dev/gmail-discovery) を使うときだけ 1 にします。
# 本番 (NODE_ENV=production) ではこの値に関係なく無効 (404) です。
ENABLE_GMAIL_DISCOVERY=

# --- 暗号化・バッチ (サーバー専用) ---
# connections テーブルに保存する OAuth トークンの暗号化鍵。
# 生成例: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# 自動更新エンドポイント(/api/cron/refresh)を保護する共有シークレット。
# 生成例: openssl rand -hex 32
CRON_SECRET=
