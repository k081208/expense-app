# ------------------------------------------------------------------
# .env.local.example
# このファイルをコピーして .env.local を作成し、値を入力してください。
#   cp .env.local.example .env.local
# .env.local は .gitignore で除外されており、コミットされません。
# 秘密情報は絶対にこのサンプルファイルへ直接書かないでください。
# ------------------------------------------------------------------

# --- Supabase (公開情報。ブラウザに露出してよい) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# アプリの公開 URL。OAuth のリダイレクト先に使う。
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (サーバー専用。絶対に NEXT_PUBLIC_ を付けない) ---
# RLS を迂回できる強力な鍵。自動更新バッチでのみ使用する。
SUPABASE_SERVICE_ROLE_KEY=

# --- Google OAuth (サーバー専用) ---
# Gmail 連携用。Google Cloud Console で作成した OAuth クライアント。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- 暗号化・バッチ (サーバー専用) ---
# connections テーブルに保存する OAuth トークンの暗号化鍵。
# 生成例: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# 自動更新エンドポイント(/api/cron/refresh)を保護する共有シークレット。
# 生成例: openssl rand -hex 32
CRON_SECRET=
